# Phase 2, Tiers 2 and 3 (docs/PHASE2.md), queued after Tier 1. Labels revisions are read from the labelling runs at job time.
# K1: teacher labels at two more sizes
uv run python scripts/label_teacher.py --config configs/teacher-qwen3-1.7b.json
uv run python scripts/label_teacher.py --config configs/teacher-qwen3-8b.json
# K2: half-teacher students from each teacher, two seeds
LREV=$(python3 -c "import json,glob; print(json.load(open(sorted(glob.glob('runs/*-teacher-qwen3-1.7b/final.json'))[-1]))['labels_revision'])"); uv run python scripts/train.py --config configs/tino-distil.json --set name=tino-distil-t1.7b seed=0 "distil={\"labels_repo\":\"BrandeisPatrick/tino-teacher-labels\",\"labels_prefix\":\"qwen3-1.7b\",\"labels_revision\":\"$LREV\",\"alpha\":0.5,\"teacher_temperature\":\"manifest\"}"
LREV=$(python3 -c "import json,glob; print(json.load(open(sorted(glob.glob('runs/*-teacher-qwen3-1.7b/final.json'))[-1]))['labels_revision'])"); uv run python scripts/train.py --config configs/tino-distil.json --set name=tino-distil-t1.7b-s1 seed=1 "distil={\"labels_repo\":\"BrandeisPatrick/tino-teacher-labels\",\"labels_prefix\":\"qwen3-1.7b\",\"labels_revision\":\"$LREV\",\"alpha\":0.5,\"teacher_temperature\":\"manifest\"}"
LREV=$(python3 -c "import json,glob; print(json.load(open(sorted(glob.glob('runs/*-teacher-qwen3-8b/final.json'))[-1]))['labels_revision'])"); uv run python scripts/train.py --config configs/tino-distil.json --set name=tino-distil-t8b seed=0 "distil={\"labels_repo\":\"BrandeisPatrick/tino-teacher-labels\",\"labels_prefix\":\"qwen3-8b\",\"labels_revision\":\"$LREV\",\"alpha\":0.5,\"teacher_temperature\":\"manifest\"}"
LREV=$(python3 -c "import json,glob; print(json.load(open(sorted(glob.glob('runs/*-teacher-qwen3-8b/final.json'))[-1]))['labels_revision'])"); uv run python scripts/train.py --config configs/tino-distil.json --set name=tino-distil-t8b-s1 seed=1 "distil={\"labels_repo\":\"BrandeisPatrick/tino-teacher-labels\",\"labels_prefix\":\"qwen3-8b\",\"labels_revision\":\"$LREV\",\"alpha\":0.5,\"teacher_temperature\":\"manifest\"}"
# K3: teacher-only students from the 8B teacher, two seeds
LREV=$(python3 -c "import json,glob; print(json.load(open(sorted(glob.glob('runs/*-teacher-qwen3-8b/final.json'))[-1]))['labels_revision'])"); uv run python scripts/train.py --config configs/tino-distil.json --set name=tino-distil-t8b-a1 seed=0 "distil={\"labels_repo\":\"BrandeisPatrick/tino-teacher-labels\",\"labels_prefix\":\"qwen3-8b\",\"labels_revision\":\"$LREV\",\"alpha\":1.0,\"teacher_temperature\":\"manifest\"}"
LREV=$(python3 -c "import json,glob; print(json.load(open(sorted(glob.glob('runs/*-teacher-qwen3-8b/final.json'))[-1]))['labels_revision'])"); uv run python scripts/train.py --config configs/tino-distil.json --set name=tino-distil-t8b-a1-s1 seed=1 "distil={\"labels_repo\":\"BrandeisPatrick/tino-teacher-labels\",\"labels_prefix\":\"qwen3-8b\",\"labels_revision\":\"$LREV\",\"alpha\":1.0,\"teacher_temperature\":\"manifest\"}"
# M0: the 0.6B adapter with the bf16 backbone the 1.7B runs use
uv run python scripts/train.py --config configs/tino-adapter.json --set name=tino-adapter-bf16 dtype=bfloat16 eval_token_budget=2048
# M1: 1.7B adapter, three seeds
uv run python scripts/train.py --config configs/tino-adapter.json --set name=tino-adapter-1.7b seed=0 base_model=Qwen/Qwen3-1.7B-Base base_revision=ea980cb0a6c2ae4b936e82123acc929f1cec04c1 dtype=bfloat16 eval_token_budget=2048
uv run python scripts/train.py --config configs/tino-adapter.json --set name=tino-adapter-1.7b-s1 seed=1 base_model=Qwen/Qwen3-1.7B-Base base_revision=ea980cb0a6c2ae4b936e82123acc929f1cec04c1 dtype=bfloat16 eval_token_budget=2048
uv run python scripts/train.py --config configs/tino-adapter.json --set name=tino-adapter-1.7b-s2 seed=2 base_model=Qwen/Qwen3-1.7B-Base base_revision=ea980cb0a6c2ae4b936e82123acc929f1cec04c1 dtype=bfloat16 eval_token_budget=2048
# M2: 1.7B half-teacher students from the 4B teacher, two seeds
uv run python scripts/train.py --config configs/tino-distil.json --set name=tino-distil-1.7b seed=0 base_model=Qwen/Qwen3-1.7B-Base base_revision=ea980cb0a6c2ae4b936e82123acc929f1cec04c1 dtype=bfloat16 eval_token_budget=2048 "distil={\"labels_repo\":\"BrandeisPatrick/tino-teacher-labels\",\"labels_prefix\":\"qwen3-4b-instruct-2507\",\"labels_revision\":\"31e5bfd7100cb600f8272437c33a7ab755a1cfbe\",\"alpha\":0.5,\"teacher_temperature\":\"manifest\"}"
uv run python scripts/train.py --config configs/tino-distil.json --set name=tino-distil-1.7b-s1 seed=1 base_model=Qwen/Qwen3-1.7B-Base base_revision=ea980cb0a6c2ae4b936e82123acc929f1cec04c1 dtype=bfloat16 eval_token_budget=2048 "distil={\"labels_repo\":\"BrandeisPatrick/tino-teacher-labels\",\"labels_prefix\":\"qwen3-4b-instruct-2507\",\"labels_revision\":\"31e5bfd7100cb600f8272437c33a7ab755a1cfbe\",\"alpha\":0.5,\"teacher_temperature\":\"manifest\"}"
# Final: every Phase 2 model on the never-seen suites
uv run python scripts/eval_suites.py --config configs/suite-eval-phase2.json
