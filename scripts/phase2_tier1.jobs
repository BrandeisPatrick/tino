# Phase 2, Tier 1 (docs/PHASE2.md): one job per line, in the order they run. Copied into queue/pending.txt.
# S1: third seeds of the four full-data recipes
uv run python scripts/train.py --config configs/tino-adapter.json --set name=tino-adapter-s2 seed=2
uv run python scripts/train.py --config configs/tino-distil.json --set name=tino-distil-s2 seed=2 'distil={"labels_repo":"BrandeisPatrick/tino-teacher-labels","labels_prefix":"qwen3-4b-instruct-2507","labels_revision":"31e5bfd7100cb600f8272437c33a7ab755a1cfbe","alpha":0.5,"teacher_temperature":"manifest"}'
uv run python scripts/train.py --config configs/tino-finetuned.json --set name=tino-finetuned-s2 seed=2
uv run python scripts/train.py --config configs/tino-distil.json --set name=tino-distil-a1-s2 seed=2 'distil={"labels_repo":"BrandeisPatrick/tino-teacher-labels","labels_prefix":"qwen3-4b-instruct-2507","labels_revision":"31e5bfd7100cb600f8272437c33a7ab755a1cfbe","alpha":1.0,"teacher_temperature":"manifest"}'
# S4: half-teacher students from the unsoftened teacher (temperature 1 instead of the fitted 9.0)
uv run python scripts/train.py --config configs/tino-distil.json --set name=tino-distil-raw 'distil={"labels_repo":"BrandeisPatrick/tino-teacher-labels","labels_prefix":"qwen3-4b-instruct-2507","labels_revision":"31e5bfd7100cb600f8272437c33a7ab755a1cfbe","alpha":0.5,"teacher_temperature":1.0}'
uv run python scripts/train.py --config configs/tino-distil.json --set name=tino-distil-raw-s1 seed=1 'distil={"labels_repo":"BrandeisPatrick/tino-teacher-labels","labels_prefix":"qwen3-4b-instruct-2507","labels_revision":"31e5bfd7100cb600f8272437c33a7ab755a1cfbe","alpha":0.5,"teacher_temperature":1.0}'
# S3: the rest of the teacher-weight curve at full data
uv run python scripts/train.py --config configs/tino-distil.json --set name=tino-distil-a025 'distil={"labels_repo":"BrandeisPatrick/tino-teacher-labels","labels_prefix":"qwen3-4b-instruct-2507","labels_revision":"31e5bfd7100cb600f8272437c33a7ab755a1cfbe","alpha":0.25,"teacher_temperature":"manifest"}'
uv run python scripts/train.py --config configs/tino-distil.json --set name=tino-distil-a075 'distil={"labels_repo":"BrandeisPatrick/tino-teacher-labels","labels_prefix":"qwen3-4b-instruct-2507","labels_revision":"31e5bfd7100cb600f8272437c33a7ab755a1cfbe","alpha":0.75,"teacher_temperature":"manifest"}'
uv run python scripts/train.py --config configs/tino-distil.json --set name=tino-distil-a025-s1 seed=1 'distil={"labels_repo":"BrandeisPatrick/tino-teacher-labels","labels_prefix":"qwen3-4b-instruct-2507","labels_revision":"31e5bfd7100cb600f8272437c33a7ab755a1cfbe","alpha":0.25,"teacher_temperature":"manifest"}'
uv run python scripts/train.py --config configs/tino-distil.json --set name=tino-distil-a075-s1 seed=1 'distil={"labels_repo":"BrandeisPatrick/tino-teacher-labels","labels_prefix":"qwen3-4b-instruct-2507","labels_revision":"31e5bfd7100cb600f8272437c33a7ab755a1cfbe","alpha":0.75,"teacher_temperature":"manifest"}'
# S2: second seed of the post-trained start
uv run python scripts/train.py --config configs/tino-adapter.json --set name=tino-adapter-post-s1 seed=1 base_model=Qwen/Qwen3-0.6B base_revision=c1899de289a04d12100db370d81485cdf75e47ca
# T1: thinking against direct answering on 800 development questions
uv run python scripts/think_eval.py --config configs/think-eval-800.json
# S5: second seed for the informative 4,000-question cells
uv run python scripts/train.py --config configs/tino-finetuned.json --set name=abl-finetuned-4k-s1 seed=1 train_limit=4000 evals_per_epoch=2 'final_evals=[["decision-v7","development"],["transfer-v4","development"]]'
uv run python scripts/train.py --config configs/tino-adapter.json --set name=abl-rank4-4k-s1 seed=1 'lora={"rank":4,"scale":2.0,"dropout":0.05}' train_limit=4000 evals_per_epoch=2 'final_evals=[["decision-v7","development"],["transfer-v4","development"]]'
uv run python scripts/train.py --config configs/tino-adapter.json --set name=abl-rank64-a32-4k-s1 seed=1 'lora={"rank":64,"scale":0.5,"dropout":0.05}' train_limit=4000 evals_per_epoch=2 'final_evals=[["decision-v7","development"],["transfer-v4","development"]]'
uv run python scripts/train.py --config configs/tino-adapter.json --set name=abl-lr5e-5-4k-s1 seed=1 backbone_lr=5e-5 train_limit=4000 evals_per_epoch=2 'final_evals=[["decision-v7","development"],["transfer-v4","development"]]'
uv run python scripts/train.py --config configs/tino-adapter.json --set name=abl-brier-4k-s1 seed=1 brier_weight=1.0 train_limit=4000 evals_per_epoch=2 'final_evals=[["decision-v7","development"],["transfer-v4","development"]]'
uv run python scripts/train.py --config configs/tino-distil.json --set name=abl-distil-a025-4k-s1 seed=1 'distil={"labels_repo":"BrandeisPatrick/tino-teacher-labels","labels_prefix":"qwen3-4b-instruct-2507","labels_revision":"31e5bfd7100cb600f8272437c33a7ab755a1cfbe","alpha":0.25,"teacher_temperature":"manifest"}' train_limit=4000 evals_per_epoch=2 'final_evals=[["decision-v7","development"],["transfer-v4","development"]]'
uv run python scripts/train.py --config configs/tino-distil.json --set name=abl-distil-a1-4k-s1 seed=1 'distil={"labels_repo":"BrandeisPatrick/tino-teacher-labels","labels_prefix":"qwen3-4b-instruct-2507","labels_revision":"31e5bfd7100cb600f8272437c33a7ab755a1cfbe","alpha":1.0,"teacher_temperature":"manifest"}' train_limit=4000 evals_per_epoch=2 'final_evals=[["decision-v7","development"],["transfer-v4","development"]]'
uv run python scripts/train.py --config configs/tino-finetuned.json --set name=abl-finetuned-1k-s1 seed=1 train_limit=1000 evals_per_epoch=2 'final_evals=[["decision-v7","development"],["transfer-v4","development"]]'
